      <aliases enabled='yes' />
      <column caption='Boundary Runs' datatype='integer' name='[Boundary_Runs]' role='measure' type='quantitative' />
      <column caption='Average' datatype='real' name='[Calculation_0651462155141120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Dismissed]) = 0 THEN NULL ELSE SUM([Runs]) / SUM([Dismissed]) END' />
      </column>
      <column caption='Strike Rate' datatype='real' name='[Calculation_0651462155374593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Runs]) / SUM([Balls]) * 100' />
      </column>
      <column caption='Boundary %' datatype='real' default-format='p0.0%' name='[Calculation_0651462155444226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Boundary_Runs]) / SUM([Runs])' />
      </column>
      <column caption='Dot Ball %' datatype='real' default-format='p0.0%' name='[Calculation_0651462155599875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Dots]) / SUM([Balls])' />
      </column>
      <column caption='Innings' datatype='integer' name='[Calculation_0651462155702276]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Match_ID])' />
      </column>
      <column caption='Metric Value' datatype='real' name='[Calculation_0651462165667846]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0651462164971525]&#13;&#10;WHEN &quot;Runs&quot; THEN SUM([Runs])&#13;&#10;WHEN &quot;Average&quot; THEN [Calculation_0651462155141120]&#13;&#10;WHEN &quot;Strike Rate&quot; THEN [Calculation_0651462155374593]&#13;&#10;WHEN &quot;Boundary %&quot; THEN [Calculation_0651462155444226]&#13;&#10;WHEN &quot;Dot Ball %&quot; THEN [Calculation_0651462155599875]&#13;&#10;END' />
